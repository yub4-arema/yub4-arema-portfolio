---
const {sns, id, icon, bgColor, href, idColor} = Astro.props;
---

<a
  href={href}
  class="m-2 rounded-lg flex items-center overflow-hidden transition-all duration-300 hover:scale-110 group"
  style={`background-color: ${bgColor};`}
>
  <!-- アイコンの余白を個別に調整 -->
  <img src={icon} alt={`${sns} icon`} class="h-[5vw] max-h-[2rem] m-2 z-10"/>
  
  <!-- ID部分：最初は幅0で見えなくしておく -->
  <span class="sns-id" style={`color: ${idColor};`}>{id}</span>
</a>

<style>
  .sns-id {
    display: inline-block;
    white-space: nowrap; /* 改行を防ぐ */
    max-width: 0;        /* 最初は幅ゼロ */
    opacity: 0;          /* 最初は透明 */
    transform: translateX(-4px);
    transition:
      max-width 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    font-weight: bold;
    font-size: clamp(0.7rem, 1.5vw, 1rem);
  }

  /* 親の a タグがホバーされた時 (group-hover) */
  a:hover .sns-id {   
    max-width: 12rem;  /* 十分大きい値にして滑らかに拡張 */
    opacity: 1;
    margin-right: 1rem;  /* 出てきた時の右余白 */
    padding-left: 0.5rem;
    transform: translateX(0);
  }
  
  /* 背景をさらに「ぬるっ」とさせたい場合、hover時のaタグ自体に transition を追加 */
  a {
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.7s ease;
    will-change: transform;
  }
</style>
