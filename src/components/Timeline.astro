---
interface Props {
  date: string;
  title: string;
}

const { date, title } = Astro.props;
---

<li class="mb-10 ml-6">
  <span class="absolute flex items-center justify-center w-3 h-3 bg-[#a60a0a] rounded-full -left-1.5 ring-4 ring-white">
  </span>
  
  <time class="inline-block py-1 text-xs font-medium text-[#a60a0a]">
    {date}
  </time>
  
  <h3 class="flex items-center mb-1 text-lg font-bold text-[#000000]">
    {title}
  </h3>
  
  <div class="text-base font-normal text-[#000000] leading-relaxed">
    <slot />
  </div>
</li>