---
const { title, href, date, service } = Astro.props;
---

<a class="article-card" href={href} target="_blank" rel="noopener noreferrer">
	<div class="article-main">
		<p class="article-title">{title}</p>
		<div class="article-meta">
			<span class="article-service">{service}</span>
			<span class="article-dot">•</span>
			<time class="article-date" datetime={date}>{date}</time>
		</div>
	</div>
	<span class="article-link">→</span>
</a>

<style>
	.article-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.25rem 1.5rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(0, 0, 0, 0.08);
		background: rgba(255, 255, 255, 0.95);
		color: inherit;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.article-card:hover {
		box-shadow:
			0 10px 15px -3px rgba(0, 0, 0, 0.1),
			0 4px 6px -2px rgba(0, 0, 0, 0.05);
	}

	.article-main {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.article-title {
		font-size: clamp(1rem, 2.4vw, 1.2rem);
		font-weight: 600;
		color: #0d0d0d;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		color: rgba(0, 0, 0, 0.6);
	}

	.article-service {
        background-color: rgba(166, 10, 10, 0.2);
		color: #a60a0a;
		padding: 0.2rem 0.6rem;
		border-radius: 1rem;
		font-weight: 600;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.article-dot {
		opacity: 0.6;
	}

	.article-link {
		font-size: 1.2rem;
		color: #a60a0a;
	}

	@media (max-width: 640px) {
		.article-card {
			flex-direction: column;
			align-items: flex-start;
		}

		.article-link {
			align-self: flex-end;
		}
	}
</style>
